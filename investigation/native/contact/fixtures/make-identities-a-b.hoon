=/  m  (strand ,vase)
=/  make
  |=  seed=@t
  =/  cic  (pit:nu:cric:crypto 512 (shaz seed) %c q:(mat %mesa-test))
  =/  who=@p  `@p`fig:ex:cic
  =/  feed=feed:jael  [[%2 ~] who 0 [1 sec:ex:cic]~]
  =/  point=point:jael
    [0 1 (my [1 [2 pub:ex:cic]]~) `who ~]
  [(scot %p who) (scot %uw (jam feed)) who point]
(pure:m !>([(make 'libmesa-contact-a') (make 'libmesa-contact-b')]))
